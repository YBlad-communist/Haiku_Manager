# Скопируй этот файл в .env и впиши свои значения.
# .env в git не попадает.

# --- Модель (AITunnel) ---
AITUNNEL_API_KEY=
BASE_URL=https://api.aitunnel.ru/v1/
MODEL=claude-haiku-5.5

# --- 2ГИС Places API ---
TWOGIS_API_KEY=

# --- Поиск в интернете ---
# stub = заглушка (пока нет ключа), yandex = Yandex Search API v2
SEARCH_PROVIDER=stub
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# Регион поиска: 225 = Россия, 213 = Москва (необязательно)
YANDEX_REGION=

# --- Лимиты (можно не менять) ---
MAX_STEPS=8
MAX_TOKENS_PER_REPLY=2500
MAX_TASK_TOKENS=40000
MAX_FETCH_CHARS=6000

# Бюджет задаётся в окне «Настройки» и хранится в data/settings.json.
# Для тестов можно временно задать BUDGET_LIMIT_RUB — он важнее настроек.
# BUDGET_LIMIT_RUB=500

# --- Сообщения (заглушка) ---
MAX_MESSAGES_PER_CONTACT=3
MAX_NEW_CONTACTS_PER_DAY=10
MIN_PAUSE_SECONDS=30
